{
  "version": 1,
  "name": "Berth Allocation Problem - continuous quay",
  "description": "Eight vessels share a 600 m quay. Each vessel takes a section of quay equal to its length. Handling is slower when a vessel berths far from its preferred position (far from its stack area). Rectangles in the time-space plan must not overlap.",
  "sets": [
    {
      "name": "V",
      "kind": "list",
      "elements": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "C7",
        "C8"
      ],
      "start": 1,
      "stop": 1,
      "step": 1,
      "expr": "",
      "dimen": 1,
      "description": "Vessels"
    },
    {
      "name": "PAIRS",
      "kind": "expression",
      "elements": [],
      "start": 1,
      "stop": 1,
      "step": 1,
      "expr": "[(u, v) for u in V for v in V if u != v]",
      "dimen": 1,
      "description": ""
    }
  ],
