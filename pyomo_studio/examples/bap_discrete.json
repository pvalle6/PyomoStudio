      "domain": "Binary",
      "lb": "",
      "ub": "",
      "init": "",
      "stage": 1,
      "description": "1 if vessel v uses berth b"
    },
    {
      "name": "y",
      "index": "(u, v) in PAIRS",
      "domain": "Binary",
      "lb": "",
      "ub": "",
      "init": "",
      "stage": 1,
      "description": "1 if u is served before v (on the same berth)"
    },
    {
      "name": "t",
      "index": "v in V",
      "domain": "NonNegativeReals",
      "lb": "a[v]",
      "ub": "a[v] + Wmax",
      "init": "",
      "stage": 2,
      "description": "Start of handling (h)"
    },
    {
      "name": "T",
      "index": "v in V",
      "domain": "NonNegativeReals",
      "lb": "",
      "ub": "",
      "init": "",
      "stage": 2,
      "description": "Late departure (h)"
    }
  ],
  "expressions": [
    {
      "name": "hand",
      "index": "v in V",
      "expr": "sum(p[v, b] * x[v, b] for b in B)",
      "description": "Handling time of v"
    },
    {
      "name": "dep",
      "index": "v in V",
      "expr": "t[v] + hand[v]",
      "description": "Departure time of v"
    }
  ],
  "constraints": [
    {
      "name": "Assign",
      "index": "v in V",
      "condition": "",
      "expr": "sum(x[v, b] for b in B) == 1",
      "active": true,
      "description": "Each vessel uses one berth"
    },
    {
      "name": "Compatible",
      "index": "v in V, b in B",
      "condition": "ok[v, b] == 0",
      "expr": "x[v, b] == 0",
      "active": true,
      "description": "No vessel at a berth that it cannot use"
    },
    {
      "name": "Order",
      "index": "(u, v) in PAIRS",
      "condition": "u < v",
      "expr": "y[u, v] + y[v, u] == 1",
      "active": true,
      "description": "One of each two vessels goes first"
    },
    {
      "name": "NoOverlap",
      "index": "(u, v) in PAIRS, b in B",
      "condition": "ok[u, b] == 1 and ok[v, b] == 1",
      "expr": "t[u] + p[u, b] <= t[v] + max(0, a[u] + Wmax + p[u, b] - a[v]) * (3 - x[u, b] - x[v, b] - y[u, v])",
      "active": true,
      "description": "Two vessels at one berth do not overlap. The big-M is the largest possible overlap of the pair."
    },
    {
      "name": "BerthOpen",
      "index": "v in V, b in B",
      "condition": "s[b] > 0",
      "expr": "t[v] >= s[b] * x[v, b]",
      "active": true,
      "description": "No start before the berth opens"
    },
    {
      "name": "Late",
      "index": "v in V",
      "condition": "",
      "expr": "T[v] >= dep[v] - d[v]",
      "active": true,
      "description": "Late departure"
    }
  ],
  "objectives": [
    {
      "name": "Cost",
      "sense": "minimize",
      "expr": "sum(w[v] * (dep[v] - a[v]) for v in V) + lam * sum(w[v] * T[v] for v in V)",
      "active": true,
      "description": "Weighted time in port + penalty for late departure"
    },
    {
      "name": "TotalWait",
      "sense": "minimize",
      "expr": "sum(t[v] - a[v] for v in V)",
      "active": false,
      "description": "KPI: total wait (h)"
    },
    {
      "name": "TotalLate",
      "sense": "minimize",
      "expr": "sum(T[v] for v in V)",
      "active": false,
      "description": "KPI: total late departure (h)"
    }
  ],
